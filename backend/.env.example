# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cambocine
DB_USER=root
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://cambocine.online

# Google Login
GOOGLE_CLIENT_ID=900896751182-351tedmbt8jq69acpbip5fmvir10092h.apps.googleusercontent.com

# Encryption Key
ENCRYPTION_KEY=your_32_character_encryption_key

# Database sync controls
# Default migrate behavior creates missing tables only.
# Set DB_SYNC_ALTER=true when you intentionally want Sequelize to alter tables.
# Set DB_SYNC_FORCE=true only when you intentionally want to drop/recreate all tables.
DB_SYNC_ALTER=false
DB_SYNC_FORCE=false
